{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meticulous.local/schemas/idle-screen-v2.schema.json",
  "title": "Meticulous Idle Screen Package Contract",
  "description": "Authoritative schemas for manifest.json and screen.json inside a .metidle package.",
  "oneOf": [
    { "$ref": "#/$defs/manifest" },
    { "$ref": "#/$defs/screen" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "packageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(custom:[a-z0-9][a-z0-9._-]{0,71}|default|digital|metCat|dvd|baristaBarista)$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "assetPath": {
      "type": "string",
      "minLength": 8,
      "maxLength": 180,
      "pattern": "^assets/[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "not": { "pattern": "(^|/)\\.\\.?(/|$)" }
    },
    "manifestAsset": {
      "type": "object",
      "required": ["id", "path", "kind", "mimeType", "size", "sha256"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "path": { "$ref": "#/$defs/assetPath" },
        "kind": { "enum": ["image", "font", "lottie"] },
        "mimeType": {
          "enum": ["image/png", "image/jpeg", "image/webp", "font/woff2", "application/vnd.meticulous.lottie+json"]
        },
        "size": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "manifest": {
      "type": "object",
      "required": ["documentType", "packageFormat", "id", "name", "version", "runtimeApi", "screen", "preview", "assets"],
      "additionalProperties": false,
      "properties": {
        "documentType": { "const": "meticulous-idle-manifest" },
        "packageFormat": { "const": 1 },
        "id": { "$ref": "#/$defs/packageId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": { "$ref": "#/$defs/semanticVersion" },
        "runtimeApi": { "const": 1 },
        "description": { "type": "string", "maxLength": 500 },
        "author": { "type": "string", "maxLength": 80 },
        "screen": { "const": "screen.json" },
        "preview": { "const": "preview.png" },
        "assets": { "type": "array", "maxItems": 125, "items": { "$ref": "#/$defs/manifestAsset" } }
      }
    },
    "color": { "type": "string", "pattern": "^#([0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
    "tokenRef": {
      "type": "object",
      "required": ["token"],
      "additionalProperties": false,
      "properties": { "token": { "type": "string", "pattern": "^(colors|fonts|numbers|strings|booleans)\\.[A-Za-z][A-Za-z0-9_-]*$" } }
    },
    "formatter": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["number", "unit", "date", "time", "duration", "boolean", "enum", "truncate"] },
        "precision": { "type": "integer", "minimum": 0, "maximum": 4 },
        "suffix": { "type": "string", "maxLength": 16 },
        "locale": { "type": "string", "maxLength": 35 },
        "options": { "type": "object", "additionalProperties": true },
        "trueLabel": { "type": "string", "maxLength": 40 },
        "falseLabel": { "type": "string", "maxLength": 40 },
        "map": { "type": "object", "maxProperties": 40, "additionalProperties": { "type": "string", "maxLength": 80 } },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    },
    "source": {
      "enum": ["time", "settings", "wifi", "machine", "sensors", "notifications", "osStatus", "deviceInfo", "profiles"]
    },
    "binding": {
      "type": "object",
      "required": ["binding"],
      "additionalProperties": false,
      "properties": {
        "binding": {
          "type": "object",
          "required": ["source", "path"],
          "additionalProperties": false,
          "properties": {
            "source": { "$ref": "#/$defs/source" },
            "path": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
            "formatter": { "$ref": "#/$defs/formatter" },
            "fallback": { "type": ["string", "number", "boolean", "null"] }
          }
        }
      }
    },
    "condition": {
      "type": "object",
      "required": ["source", "path", "operator"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "path": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
        "operator": { "enum": ["truthy", "falsy", "present", "eq", "neq", "gt", "gte", "lt", "lte"] },
        "value": { "type": ["string", "number", "boolean", "null"] },
        "fallback": { "type": "boolean", "default": false }
      }
    },
    "dynamicNumber": { "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/tokenRef" }, { "$ref": "#/$defs/binding" }] },
    "dynamicString": { "oneOf": [{ "type": "string", "maxLength": 500 }, { "$ref": "#/$defs/tokenRef" }, { "$ref": "#/$defs/binding" }] },
    "dynamicColor": { "oneOf": [{ "$ref": "#/$defs/color" }, { "$ref": "#/$defs/tokenRef" }, { "$ref": "#/$defs/binding" }] },
    "dynamicBoolean": { "oneOf": [{ "type": "boolean" }, { "$ref": "#/$defs/tokenRef" }, { "$ref": "#/$defs/binding" }, { "$ref": "#/$defs/condition" }] },
    "dynamicFontStyle": { "oneOf": [{ "enum": ["normal", "italic"] }, { "$ref": "#/$defs/tokenRef" }, { "$ref": "#/$defs/binding" }] },
    "dynamicTextAlign": { "oneOf": [{ "enum": ["left", "center", "right"] }, { "$ref": "#/$defs/tokenRef" }, { "$ref": "#/$defs/binding" }] },
    "dynamicShape": { "oneOf": [{ "enum": ["rectangle", "roundedRectangle", "circle", "line"] }, { "$ref": "#/$defs/tokenRef" }, { "$ref": "#/$defs/binding" }] },
    "dynamicVerticalAlign": { "oneOf": [{ "enum": ["top", "middle", "bottom"] }, { "$ref": "#/$defs/tokenRef" }, { "$ref": "#/$defs/binding" }] },
    "dynamicWrap": { "oneOf": [{ "enum": ["none", "word", "character"] }, { "$ref": "#/$defs/tokenRef" }, { "$ref": "#/$defs/binding" }] },
    "dynamicHandUnit": { "oneOf": [{ "enum": ["hour", "minute", "second", "custom"] }, { "$ref": "#/$defs/tokenRef" }, { "$ref": "#/$defs/binding" }] },
    "dynamicHandShape": { "oneOf": [{ "enum": ["rectangle", "rounded", "tapered", "needle", "image"] }, { "$ref": "#/$defs/tokenRef" }, { "$ref": "#/$defs/binding" }] },
    "dynamicTimeTemplate": { "oneOf": [{ "enum": ["HH:mm", "HH:mm:ss", "mm:ss", "mm", "HH", "ss", "hh:mm a", "hh:mm:ss a", "stackedHM"] }, { "$ref": "#/$defs/tokenRef" }, { "$ref": "#/$defs/binding" }] },
    "dynamicHourMode": { "oneOf": [{ "enum": ["locale", "12", "24"] }, { "$ref": "#/$defs/tokenRef" }, { "$ref": "#/$defs/binding" }] },
    "dynamicBlendMode": { "oneOf": [{ "enum": ["normal", "multiply", "screen", "overlay"] }, { "$ref": "#/$defs/tokenRef" }, { "$ref": "#/$defs/binding" }] },
    "dynamicGroupClip": { "oneOf": [{ "enum": ["none", "bounds", "circle"] }, { "$ref": "#/$defs/tokenRef" }, { "$ref": "#/$defs/binding" }] },
    "dynamicImageFit": { "oneOf": [{ "enum": ["contain", "cover", "fill", "none"] }, { "$ref": "#/$defs/tokenRef" }, { "$ref": "#/$defs/binding" }] },
    "transform": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "$ref": "#/$defs/dynamicNumber" },
        "y": { "$ref": "#/$defs/dynamicNumber" },
        "width": { "$ref": "#/$defs/dynamicNumber" },
        "height": { "$ref": "#/$defs/dynamicNumber" },
        "rotation": { "$ref": "#/$defs/dynamicNumber" },
        "anchorX": { "$ref": "#/$defs/dynamicNumber" },
        "anchorY": { "$ref": "#/$defs/dynamicNumber" },
        "scaleX": { "$ref": "#/$defs/dynamicNumber" },
        "scaleY": { "$ref": "#/$defs/dynamicNumber" }
      }
    },
    "font": {
      "type": "object",
      "required": ["family", "size"],
      "additionalProperties": false,
      "properties": {
        "family": { "$ref": "#/$defs/dynamicString" },
        "asset": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "size": { "$ref": "#/$defs/dynamicNumber" },
        "weight": { "$ref": "#/$defs/dynamicNumber" },
        "style": { "$ref": "#/$defs/dynamicFontStyle" },
        "align": { "$ref": "#/$defs/dynamicTextAlign" },
        "lineHeight": { "$ref": "#/$defs/dynamicNumber" },
        "tabularNumbers": { "$ref": "#/$defs/dynamicBoolean" }
      }
    },
    "layerBase": {
      "type": "object",
      "required": ["id", "type", "transform"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "type": { "type": "string" },
        "name": { "type": "string", "maxLength": 80 },
        "transform": { "$ref": "#/$defs/transform" },
        "visible": { "$ref": "#/$defs/dynamicBoolean" },
        "opacity": { "$ref": "#/$defs/dynamicNumber" },
        "locked": { "type": "boolean", "default": false },
        "blendMode": { "$ref": "#/$defs/dynamicBlendMode" }
      }
    },
    "groupLayer": {
      "allOf": [{ "$ref": "#/$defs/layerBase" }, { "type": "object", "required": ["children"], "properties": {
        "type": { "const": "group" }, "clip": { "$ref": "#/$defs/dynamicGroupClip" },
        "children": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/layer" } }
      }}], "unevaluatedProperties": false
    },
    "shapeLayer": {
      "allOf": [{ "$ref": "#/$defs/layerBase" }, { "type": "object", "required": ["shape"], "properties": {
        "type": { "const": "shape" }, "shape": { "$ref": "#/$defs/dynamicShape" },
        "fill": { "$ref": "#/$defs/dynamicColor" }, "stroke": { "$ref": "#/$defs/dynamicColor" },
        "strokeWidth": { "$ref": "#/$defs/dynamicNumber" }, "cornerRadius": { "$ref": "#/$defs/dynamicNumber" }
      }}], "unevaluatedProperties": false
    },
    "textLayer": {
      "allOf": [{ "$ref": "#/$defs/layerBase" }, { "type": "object", "required": ["text", "font", "color"], "properties": {
        "type": { "const": "text" }, "text": { "$ref": "#/$defs/dynamicString" }, "font": { "$ref": "#/$defs/font" },
        "color": { "$ref": "#/$defs/dynamicColor" }, "verticalAlign": { "$ref": "#/$defs/dynamicVerticalAlign" },
        "wrap": { "$ref": "#/$defs/dynamicWrap" }, "maxLines": { "$ref": "#/$defs/dynamicNumber" }
      }}], "unevaluatedProperties": false
    },
    "imageVariant": {
      "type": "object", "required": ["when", "asset"], "additionalProperties": false,
      "properties": { "when": { "$ref": "#/$defs/condition" }, "asset": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" } }
    },
    "imageLayer": {
      "allOf": [{ "$ref": "#/$defs/layerBase" }, { "type": "object", "required": ["asset"], "properties": {
        "type": { "const": "image" }, "asset": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "fit": { "$ref": "#/$defs/dynamicImageFit" },
        "variants": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/imageVariant" } }
      }}], "unevaluatedProperties": false
    },
    "tickStyle": {
      "type": "object", "required": ["every", "width", "length", "color"], "additionalProperties": false,
      "properties": {
        "every": { "$ref": "#/$defs/dynamicNumber" }, "offset": { "$ref": "#/$defs/dynamicNumber" },
        "width": { "$ref": "#/$defs/dynamicNumber" }, "length": { "$ref": "#/$defs/dynamicNumber" },
        "color": { "$ref": "#/$defs/dynamicColor" }, "radiusOffset": { "$ref": "#/$defs/dynamicNumber" },
        "rounded": { "$ref": "#/$defs/dynamicBoolean" }
      }
    },
    "tickRingLayer": {
      "allOf": [{ "$ref": "#/$defs/layerBase" }, { "type": "object", "required": ["count", "radius", "styles"], "properties": {
        "type": { "const": "tickRing" }, "count": { "$ref": "#/$defs/dynamicNumber" },
        "radius": { "$ref": "#/$defs/dynamicNumber" }, "startAngle": { "$ref": "#/$defs/dynamicNumber" },
        "hourTicksOnly": { "$ref": "#/$defs/dynamicBoolean" },
        "styles": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/tickStyle" } }
      }}], "unevaluatedProperties": false
    },
    "analogHandLayer": {
      "allOf": [{ "$ref": "#/$defs/layerBase" }, { "type": "object", "required": ["pivot", "distanceFromCenter", "timeUnit", "rotation", "length", "width", "shape"], "properties": {
        "type": { "const": "analogHand" }, "timeUnit": { "$ref": "#/$defs/dynamicHandUnit" },
        "pivot": { "type": "object", "required": ["x", "y"], "properties": { "x": { "$ref": "#/$defs/dynamicNumber" }, "y": { "$ref": "#/$defs/dynamicNumber" } }, "additionalProperties": false },
        "distanceFromCenter": { "oneOf": [{ "type": "number", "minimum": 0, "maximum": 480 }, { "$ref": "#/$defs/tokenRef" }, { "$ref": "#/$defs/binding" }] },
        "rotation": { "$ref": "#/$defs/dynamicNumber" }, "length": { "$ref": "#/$defs/dynamicNumber" },
        "width": { "$ref": "#/$defs/dynamicNumber" }, "tailLength": { "$ref": "#/$defs/dynamicNumber" },
        "shape": { "$ref": "#/$defs/dynamicHandShape" }, "color": { "$ref": "#/$defs/dynamicColor" },
        "asset": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" }, "smooth": { "$ref": "#/$defs/dynamicBoolean" }
      }}], "unevaluatedProperties": false
    },
    "pivotCapLayer": {
      "allOf": [{ "$ref": "#/$defs/layerBase" }, { "type": "object", "required": ["diameter", "color"], "properties": {
        "type": { "const": "pivotCap" }, "diameter": { "$ref": "#/$defs/dynamicNumber" }, "color": { "$ref": "#/$defs/dynamicColor" },
        "borderColor": { "$ref": "#/$defs/dynamicColor" }, "borderWidth": { "$ref": "#/$defs/dynamicNumber" }
      }}], "unevaluatedProperties": false
    },
    "digitalTimeLayer": {
      "allOf": [{ "$ref": "#/$defs/layerBase" }, { "type": "object", "required": ["template", "hourMode", "font", "color"], "properties": {
        "type": { "const": "digitalTime" }, "template": { "$ref": "#/$defs/dynamicTimeTemplate" },
        "hourMode": { "$ref": "#/$defs/dynamicHourMode" }, "font": { "$ref": "#/$defs/font" }, "color": { "$ref": "#/$defs/dynamicColor" },
        "middayFont": { "$ref": "#/$defs/font" }, "middayColor": { "$ref": "#/$defs/dynamicColor" },
        "separatorBlink": { "type": "boolean", "default": false }
      }}], "unevaluatedProperties": false
    },
    "progressArcLayer": {
      "allOf": [{ "$ref": "#/$defs/layerBase" }, { "type": "object", "required": ["value", "minimum", "maximum", "startAngle", "sweepAngle", "strokeWidth", "color"], "properties": {
        "type": { "const": "progressArc" }, "value": { "$ref": "#/$defs/dynamicNumber" }, "minimum": { "$ref": "#/$defs/dynamicNumber" },
        "maximum": { "$ref": "#/$defs/dynamicNumber" }, "startAngle": { "$ref": "#/$defs/dynamicNumber" },
        "sweepAngle": { "$ref": "#/$defs/dynamicNumber" }, "strokeWidth": { "$ref": "#/$defs/dynamicNumber" },
        "color": { "$ref": "#/$defs/dynamicColor" }, "trackColor": { "$ref": "#/$defs/dynamicColor" }, "rounded": { "$ref": "#/$defs/dynamicBoolean" }
      }}], "unevaluatedProperties": false
    },
    "lottieSegment": {
      "type": "object", "required": ["name", "from", "to"], "additionalProperties": false,
      "properties": { "name": { "type": "string", "minLength": 1, "maxLength": 40 }, "from": { "type": "integer", "minimum": 0 },
        "to": { "type": "integer", "minimum": 1 }, "loop": { "type": "boolean", "default": false }, "playOnce": { "type": "boolean", "default": false } }
    },
    "lottieLayer": {
      "allOf": [{ "$ref": "#/$defs/layerBase" }, { "type": "object", "required": ["asset"], "properties": {
        "type": { "const": "lottie" }, "asset": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" },
        "autoplay": { "$ref": "#/$defs/dynamicBoolean" }, "loop": { "$ref": "#/$defs/dynamicBoolean" },
        "speed": { "$ref": "#/$defs/dynamicNumber" },
        "segments": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/lottieSegment" } }
      }}], "unevaluatedProperties": false
    },
    "layer": {
      "oneOf": [
        { "$ref": "#/$defs/groupLayer" }, { "$ref": "#/$defs/shapeLayer" }, { "$ref": "#/$defs/textLayer" },
        { "$ref": "#/$defs/imageLayer" }, { "$ref": "#/$defs/tickRingLayer" }, { "$ref": "#/$defs/analogHandLayer" },
        { "$ref": "#/$defs/pivotCapLayer" }, { "$ref": "#/$defs/digitalTimeLayer" }, { "$ref": "#/$defs/progressArcLayer" },
        { "$ref": "#/$defs/lottieLayer" }
      ]
    },
    "viewport": {
      "type": "object", "required": ["width", "height", "shape", "background", "overflow"], "additionalProperties": false,
      "properties": { "width": { "const": 480 }, "height": { "const": 480 }, "shape": { "const": "circle" },
        "background": { "$ref": "#/$defs/dynamicColor" }, "overflow": { "const": "hidden" } }
    },
    "runtime": {
      "type": "object", "required": ["brightness", "burnInProtection"], "additionalProperties": false,
      "properties": {
        "brightness": {
          "type": "object", "required": ["onEnter", "onExit"], "additionalProperties": false,
          "properties": { "onEnter": { "type": "number", "minimum": 0.03, "maximum": 1 }, "onExit": { "const": 1 },
            "cycleAfterMs": { "type": "integer", "minimum": 60000, "maximum": 86400000 },
            "dimValue": { "type": "number", "minimum": 0.03, "maximum": 1 }, "brightValue": { "type": "number", "minimum": 0.03, "maximum": 1 },
            "dimDurationMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
            "brightDurationMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 } }
        },
        "burnInProtection": {
          "type": "object", "required": ["enabled", "mode", "durationMs", "distance"], "additionalProperties": false,
          "properties": { "enabled": { "type": "boolean" }, "mode": { "enum": ["rotate", "translate", "none"] },
            "durationMs": { "type": "integer", "minimum": 60000, "maximum": 86400000 }, "distance": { "type": "number", "minimum": 0, "maximum": 4 } }
        }
      }
    },
    "tokens": {
      "type": "object", "required": ["colors", "fonts", "numbers"], "additionalProperties": false,
      "properties": {
        "colors": { "type": "object", "maxProperties": 64, "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" }, "additionalProperties": { "$ref": "#/$defs/color" } },
        "fonts": { "type": "object", "maxProperties": 32, "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" }, "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "numbers": { "type": "object", "maxProperties": 64, "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" }, "additionalProperties": { "type": "number" } },
        "strings": { "type": "object", "maxProperties": 64, "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" }, "additionalProperties": { "type": "string", "maxLength": 500 } },
        "booleans": { "type": "object", "maxProperties": 64, "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" }, "additionalProperties": { "type": "boolean" } }
      }
    },
    "dataSource": {
      "type": "object", "required": ["id", "source"], "additionalProperties": false,
      "properties": { "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$" }, "source": { "$ref": "#/$defs/source" },
        "refreshMs": { "type": "integer", "minimum": 250, "maximum": 3600000 } }
    },
    "screen": {
      "type": "object",
      "required": ["documentType", "schemaVersion", "runtimeApi", "id", "name", "viewport", "runtime", "tokens", "dataSources", "layers"],
      "additionalProperties": false,
      "properties": {
        "documentType": { "const": "meticulous-idle-screen" }, "schemaVersion": { "const": 2 }, "runtimeApi": { "const": 1 },
        "id": { "$ref": "#/$defs/packageId" }, "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "viewport": { "$ref": "#/$defs/viewport" }, "runtime": { "$ref": "#/$defs/runtime" }, "tokens": { "$ref": "#/$defs/tokens" },
        "dataSources": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/dataSource" } },
        "layers": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/layer" } }
      }
    }
  }
}
