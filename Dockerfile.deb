# syntax=docker/dockerfile:1
# Builds the meticulous-backend .deb that meticulous-machine installs.
#
# The Rust backend is built natively for the target architecture (CI runs
# this on an arm64 runner for the machines and on amd64 for the tests). The
# package is a drop-in for the Python one: same name, same
# /usr/bin/meticulous-backend and met-config, and the paths the machine image
# relies on (/opt/meticulous-backend/api/web_ui for nginx,
# /opt/meticulous-venv/bin/python3 and /opt/meticulous-backend/met-config.py
# for its own scripts).

# Stage 1: a Rust toolchain on the machine image's base, and cargo-chef so the
# dependencies are a cached layer of their own.
FROM debian:bookworm AS toolchain
RUN apt-get update -y && apt-get install -y --no-install-recommends \
        ca-certificates curl build-essential pkg-config git \
    && rm -rf /var/lib/apt/lists/*
ENV RUSTUP_HOME=/usr/local/rustup CARGO_HOME=/usr/local/cargo PATH=/usr/local/cargo/bin:$PATH
WORKDIR /build
COPY rust-toolchain.toml ./
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain none \
    && rustup toolchain install \
    && cargo install cargo-chef --locked --version 0.1.78

FROM toolchain AS planner
COPY . .
RUN cargo chef prepare --recipe-path recipe.json

FROM toolchain AS builder
COPY --from=planner /build/recipe.json recipe.json
RUN cargo chef cook --release --locked --recipe-path recipe.json -p meticulous-backend
COPY . .
RUN cargo build --release --locked -p meticulous-backend \
    && cp target/release/meticulous-backend /meticulous-backend

# Stage 2: assemble the .deb
FROM debian:bookworm AS packager

RUN apt-get update -y && apt-get install -y --no-install-recommends dpkg-dev gettext-base

ARG VERSION=0.1.0
ARG ARCH=amd64

WORKDIR /pkg

# Static debian packaging skeleton with version and architecture filled in.
COPY debian/ /pkg/
RUN envsubst '${VERSION} ${ARCH}' < /pkg/DEBIAN/control > /pkg/DEBIAN/control.tmp \
    && mv /pkg/DEBIAN/control.tmp /pkg/DEBIAN/control

COPY --from=builder /meticulous-backend /pkg/usr/bin/meticulous-backend
RUN chmod 755 /pkg/DEBIAN/postinst /pkg/usr/bin/meticulous-backend /pkg/usr/bin/met-config

# Paths the machine image uses: its met-config wrapper and its smoke report run
# /opt/meticulous-venv/bin/python3, which the Python package provided.
RUN mkdir -p opt/meticulous-venv/bin opt/meticulous-backend/api/web_ui \
        opt/meticulous-backend/images/default opt/meticulous-backend/sounds \
    && ln -s /usr/bin/python3 opt/meticulous-venv/bin/python3
COPY packaging/met-config.py /pkg/opt/meticulous-backend/met-config.py

# Read-only data the backend reads at run time.
COPY UI_timezones.json simple_profile.json /pkg/opt/meticulous-backend/
COPY sounds/ /pkg/opt/meticulous-backend/sounds/
COPY images/default/*.png images/default/accent_colors.json /pkg/opt/meticulous-backend/images/default/

RUN mkdir -p /out && dpkg-deb --build --root-owner-group /pkg /out/meticulous-backend_${VERSION}_${ARCH}.deb

# Final stage: just the .deb file for extraction
FROM scratch
COPY --from=packager /out/*.deb /
